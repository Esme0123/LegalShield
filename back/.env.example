# Copiar como .env y completar. NUNCA subir el .env real al repositorio.

# --- Servidor ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# --- Base de datos (MySQL / MariaDB · XAMPP) ---
# config/db.js usa estas variables (no hay soporte de DATABASE_URL).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=legalshield_db
DB_USER=root
DB_PASSWORD=
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000

# --- JWT ---
# JWT_SECRET y JWT_REFRESH_SECRET son OBLIGATORIOS: valor propio de al menos 32
# caracteres y JWT_REFRESH_SECRET distinto de JWT_SECRET. El servidor no arranca
# con los valores de ejemplo, por lo que ambos deben reemplazarse.
# Generar cada uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplazar_por_un_secreto_aleatorio_de_64_caracteres
JWT_EXPIRES_IN=45m
JWT_REFRESH_SECRET=reemplazar_por_otro_secreto_aleatorio_distinto
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=legalshield-api

# --- Politica de contrasenas ---
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_LIMIT=5
MAX_FAILED_ATTEMPTS=3

# --- Politica de bloqueo y recuperacion ---
LOCK_MINUTES=15
LOCK_MINUTES_SECOND=30
LOCK_HARD_THRESHOLD=3
# Secreto del HMAC del token OTP. OBLIGATORIO: minimo 32 caracteres y distinto de
# JWT_SECRET y de JWT_REFRESH_SECRET.
# El servidor rechaza el valor de ejemplo, por lo que debe reemplazarse.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
UNLOCK_TOKEN_SECRET=reemplazar_por_un_secreto_aleatorio_de_64_caracteres
UNLOCK_TOKEN_TTL_MINUTES=15
UNLOCK_TOKEN_MAX_ATTEMPTS=5
UNLOCK_TOKEN_MAX_ISSUES_PER_HOUR=3

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Comprobante / User ID ---
USER_CODE_PREFIX=LEG
# Opcional: si no se define, se usa el anio en curso al arrancar el servidor.
# Fijarlo congela el anio de los User ID nuevos aunque cambie el calendario.
# USER_CODE_YEAR=2026