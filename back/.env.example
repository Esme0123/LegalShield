# Copiar como .env y completar. NUNCA subir el .env real al repositorio.

# --- Servidor ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# --- Base de datos (PostgreSQL) ---
# Opcion 1: URL completa
DATABASE_URL=postgres://legalshield:legalshield@localhost:5432/legalshield

# Opcion 2: variables sueltas (se usan si DATABASE_URL no esta definida)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=legalshield
DB_USER=legalshield
DB_PASSWORD=cambiar_en_produccion
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

# --- JWT ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplazar_por_un_secreto_aleatorio_de_64_caracteres
JWT_EXPIRES_IN=45m
JWT_REFRESH_SECRET=reemplazar_por_otro_secreto_aleatorio_distinto
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=legalshield-api

# --- Politica de contrasenas ---
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_LIMIT=5
MAX_FAILED_ATTEMPTS=3

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Comprobante / User ID ---
USER_CODE_PREFIX=LEG
USER_CODE_YEAR=2026